# Discord
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=  # optional: set for faster guild-only command sync during development

# Football data
# Bundled real team/squad data for top 5 leagues is included (no API key required).
# Optionally set a live API key for refresh/current data from API-Football (api-sports.io).
FOOTBALL_API_KEY=
FOOTBALL_API_BASE_URL=https://v3.football.api-sports.io
FOOTBALL_API_SEASON=2026  # season year used for bundled/refresh data (e.g. 2026 for 2026/27)
FOOTBALL_DATA_SOURCE=bundled  # bundled | api | auto (bundled default, api if key set, auto tries api then bundled)

# Database
DATABASE_PATH=./football_bot.sqlite3

# Bot behavior
COMMAND_PREFIX=!
LOG_LEVEL=INFO
MATCH_TICK_SECONDS=1.2  # pacing for commentary delivery (seconds per simulated batch)
CACHE_TTL_HOURS=24
API_REQUEST_TIMEOUT=20
API_MAX_RETRIES=3


# Optional LLM (natural language tactics parsing / assistant features / negotiations)
# Uses an OpenAI-compatible chat completions API. Leave empty to use deterministic parsing only.
# Get a key from the official Google AI Studio: https://aistudio.google.com/apikey
# Gemini (OpenAI-compatible) example:
# LLM_API_KEY=your_gemini_api_key_here
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.8-flash
# Optional: comma-separated keys for rotation on quota/rate limits
# LLM_API_KEYS=key1,key2,key3
# Optional: comma-separated model fallback chain (tried in order after LLM_MODEL)
# LLM_MODELS=gemini-3.8-flash,gemini-3.8-flash-preview,gemini-3-flash-preview,gemini-2.0-flash
#
# Optional fallback providers (used automatically when Gemini fails/quota exhausted)
# OpenRouter (OpenAI-compatible): https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_API_KEYS=key1,key2
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODELS=nvidia/nemotron-3.5-lightning,nvidia/nemotron-3.5-super-vl
#
# Groq (OpenAI-compatible, fast small models): https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_API_KEYS=key1,key2
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile,gemma2-9b-it
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT=20
