# Discord
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=  # optional: set for faster guild-only command sync during development

# Football data
# Bundled real team/squad data for top 5 leagues is included (no API key required).
# Optionally set a live API key for refresh/current data from API-Football (api-sports.io).
FOOTBALL_API_KEY=
FOOTBALL_API_BASE_URL=https://v3.football.api-sports.io
FOOTBALL_API_SEASON=2026  # season year used for bundled/refresh data (e.g. 2026 for 2026/27)
FOOTBALL_DATA_SOURCE=bundled  # bundled | api | auto (bundled default, api if key set, auto tries api then bundled)

# Database
DATABASE_PATH=./football_bot.sqlite3

# Bot behavior
COMMAND_PREFIX=!
LOG_LEVEL=INFO
MATCH_TICK_SECONDS=1.2  # pacing for commentary delivery (seconds per simulated batch)
CACHE_TTL_HOURS=24
API_REQUEST_TIMEOUT=20
API_MAX_RETRIES=3


# Optional LLM (natural language tactics parsing / assistant features / negotiations)
# Uses an OpenAI-compatible chat completions API. Leave empty to use deterministic parsing only.
# Gemini (OpenAI-compatible) example:
# LLM_API_KEY=your_gemini_api_key_here
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT=20
